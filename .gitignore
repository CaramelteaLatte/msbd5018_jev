# Local credentials (copy .env.example to .env)
.env
.env.*
!.env.example

# VitaminC data; keep source documentation, license and split metadata
/data/vitaminc/*.jsonl
/data/vitaminc_splits/*.jsonl
/data/vitaminc_splits_v2/*.jsonl
/data/*.zip
!/data/vitaminc.zip
!/data/vitaminc_v2.zip
/data/*.tar.gz
/data/*.zip.tmp

# Per-request results and resumable checkpoints; keep reports and figures
/code/*_results/*.jsonl
/code/*_results_v2/*.jsonl
*.log
*.sqlite3
*.sqlite3-*
.run.lock

# Python environments and caches
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/

# OS and editor files
.DS_Store
._*
__MACOSX/
.idea/
.vscode/
